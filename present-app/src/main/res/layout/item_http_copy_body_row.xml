<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="?attr/spaceLarge"
    android:gravity="start|center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/row_copy_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="?attr/spaceSmall">

        <ImageButton
            android:id="@+id/iv_copy_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:padding="?attr/spaceSmall2"
            android:src="@drawable/baseline_content_copy_24" />

        <TextView
            android:id="@+id/tv_copy_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_http_copy_body" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_copy_curl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/spaceLarge"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="?attr/spaceSmall">

        <ImageButton
            android:id="@+id/iv_copy_curl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:padding="?attr/spaceSmall2"
            android:src="@drawable/baseline_content_copy_24" />

        <TextView
            android:id="@+id/tv_copy_curl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_http_copy_curl_short" />

    </LinearLayout>

</LinearLayout>
